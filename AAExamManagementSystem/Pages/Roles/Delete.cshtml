@page "{id}"
@model AAExamManagementSystem.Pages.Roles.DeleteModel
@{
    ViewData["Title"] = "Delete Role";
}

<h1>Delete Role</h1>
<p class="text-danger">Are you sure you want to delete this role?</p>

<div class="row">
    <div class="col-md-4">
        <dl class="row">
            <dt class="col-sm-4">Id</dt>
            <dd class="col-sm-8">@Model.Role.Id</dd>
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Role.Name</dd>
        </dl>
        <form method="post" data-confirm-title="Delete role?" data-confirm-text="Are you sure you want to delete &quot;{name}&quot;? This action cannot be undone." data-confirm-name="@Model.Role.Name" data-confirm-button="Delete" data-confirm-variant="danger">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_SweetAlertScripts" />
}
