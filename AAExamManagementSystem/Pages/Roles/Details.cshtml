@page "{id}"
@model AAExamManagementSystem.Pages.Roles.DetailsModel
@{
    ViewData["Title"] = "Role Details";
}

@await Component.InvokeAsync("DetailsCard", new
{
    title = "Role Details",
    fields = new[]
    {
        new DetailsField("Id", Model.Role.Id),
        new DetailsField("Name", Model.Role.Name)
    },
    showStatus = true,
    isActive = Model.Role.IsActive,
    editHref = $"/Roles/Edit/{Model.Role.Id}",
    backHref = "/Roles"
})
