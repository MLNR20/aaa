@page "{id}"
@model AAExamManagementSystem.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<edit-card title="Edit User">
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="TargetUser.FirstName" class="form-label"></label>
                    <input asp-for="TargetUser.FirstName" class="form-control" />
                    <span asp-validation-for="TargetUser.FirstName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TargetUser.LastName" class="form-label"></label>
                    <input asp-for="TargetUser.LastName" class="form-control" />
                    <span asp-validation-for="TargetUser.LastName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TargetUser.Email" class="form-label"></label>
                    <input asp-for="TargetUser.Email" class="form-control" />
                    <span asp-validation-for="TargetUser.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TargetUser.SectionId" class="form-label"></label>
                    <select asp-for="TargetUser.SectionId" class="form-select" asp-items="Model.SectionOptions">
                        <option value="">-- No Section --</option>
                    </select>
                    <span asp-validation-for="TargetUser.SectionId" class="text-danger"></span>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="TargetUser.IsActive" class="form-check-input" role="switch" />
                    <label asp-for="TargetUser.IsActive" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</edit-card>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
