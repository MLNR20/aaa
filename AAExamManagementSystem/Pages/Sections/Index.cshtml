@page
@model AAExamManagementSystem.Pages.Sections.IndexModel
@{
    ViewData["Title"] = "Sections";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "sectionsTable",
    basePath = "/Sections",
    emptyMessage = "No sections found.",
    items = Model.Sections.Select(s => new EntityTableRow(s.Id.ToString(), s.Name, DateCreated: s.DateCreated, DateUpdated: s.DateUpdated)),
    title = "Sections",
    addButtonText = "New Section",
    addButtonModalTarget = "#createSectionModal",
    showStatusColumn = false,
    showDateCreatedColumn = true,
    showDateUpdatedColumn = true,
    confirmDeleteWithSweetAlert = true,
    showRowNumberColumn = true
})

<div class="modal fade" id="createSectionModal" tabindex="-1" aria-labelledby="createSectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" id="createSectionForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="createSectionModalLabel">New Section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewSection.Name" class="form-label"></label>
                        <input asp-for="NewSection.Name" class="form-control" />
                        <span asp-validation-for="NewSection.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/sweetalert-toast.js" asp-append-version="true"></script>
    <partial name="_SuccessToast" />
    <script>
        $(function () {
            if ($('#sectionsTable').length) {
                var table = $('#sectionsTable').DataTable({
                    pagingType: 'simple_numbers',
                    order: [[1, 'asc']],
                    columnDefs: [{ targets: 0, orderable: false, searchable: false }]
                });
                // Keep the # column sequential across sorting, searching and paging.
                table.on('draw.dt', function () {
                    var start = table.page.info().start;
                    table.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                        cell.textContent = start + i + 1;
                    });
                }).draw();
            }
            @if (Model.ShowCreateModal)
            {
                <text>new bootstrap.Modal(document.getElementById('createSectionModal')).show();</text>
            }

            var createForm = document.getElementById('createSectionForm');
            createForm.addEventListener('submit', function (e) {
                e.preventDefault();
                if (window.jQuery && $.fn.valid && !$(createForm).valid()) {
                    return;
                }
                var name = createForm.querySelector('[name="NewSection.Name"]').value.trim();
                Swal.fire({
                    target: document.getElementById('createSectionModal'),
                    title: 'Create section?',
                    text: 'Are you sure you want to create "' + name + '"?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Create',
                    confirmButtonColor: '#0d6efd',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        createForm.submit();
                    }
                });
            });

            document.querySelectorAll('.js-sweetalert-delete-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var name = form.querySelector('.js-sweetalert-delete').dataset.name;
                    Swal.fire({
                        title: 'Delete section?',
                        text: 'Are you sure you want to delete "' + name + '"? This action cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Delete',
                        confirmButtonColor: '#dc3545',
                        cancelButtonText: 'Cancel'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}
