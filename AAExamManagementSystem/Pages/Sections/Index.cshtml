@page
@model AAExamManagementSystem.Pages.Sections.IndexModel
@{
    ViewData["Title"] = "Sections";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "sectionsTable",
    basePath = "/Sections",
    emptyMessage = "No sections found.",
    items = Model.Sections.Select(s => new EntityTableRow(s.Id.ToString(), s.Name, s.IsActive, s.DateCreated)),
    title = "Sections",
    addButtonText = "New Section",
    addButtonModalTarget = "#createSectionModal",
    showStatusColumn = true,
    showDateCreatedColumn = true,
    confirmDeleteWithSweetAlert = true,
    confirmCreateWithSweetAlert = true,
    entityName = "Section",
    useSoftDelete = true
})

<div class="modal fade" id="createSectionModal" tabindex="-1" aria-labelledby="createSectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" class="js-sweetalert-create-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="createSectionModalLabel">New Section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewSection.Name" class="form-label"></label>
                        <input asp-for="NewSection.Name" class="form-control" />
                        <span asp-validation-for="NewSection.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            if ($('#sectionsTable').length) {
                initEntityTable('sectionsTable');
            }
            @if (Model.ShowCreateModal)
            {
                <text>new bootstrap.Modal(document.getElementById('createSectionModal')).show();</text>
            }

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                </text>
            }
        });
    </script>
}
