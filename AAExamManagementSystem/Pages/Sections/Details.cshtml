@page "{id:int}"
@model AAExamManagementSystem.Pages.Sections.DetailsModel
@{
    ViewData["Title"] = "Section Details";
}

@await Component.InvokeAsync("DetailsCard", new
{
    title = "Section Details",
    fields = new[]
    {
        new DetailsField("Id", Model.Section.Id.ToString()),
        new DetailsField("Name", Model.Section.Name)
    },
    editHref = $"/Sections/Edit/{Model.Section.Id}",
    backHref = "/Sections"
})
