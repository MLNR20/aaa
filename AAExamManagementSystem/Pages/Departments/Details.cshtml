@page "{id:int}"
@model AAExamManagementSystem.Pages.Departments.DetailsModel
@{
    ViewData["Title"] = "Department Details";
}

@await Component.InvokeAsync("DetailsCard", new
{
    title = "Department Details",
    fields = new[]
    {
        new DetailsField("Id", Model.Department.Id.ToString()),
        new DetailsField("Name", Model.Department.Name),
        new DetailsField("Date Created", Model.Department.CreatedAt.ToString("MMM d, yyyy h:mm tt")),
        new DetailsField("Date Updated", Model.Department.DateUpdated.ToString("MMM d, yyyy h:mm tt"))
    },
    showStatus = true,
    isActive = Model.Department.IsActive,
    editHref = $"/Departments/Edit/{Model.Department.Id}",
    backHref = "/Departments"
})
