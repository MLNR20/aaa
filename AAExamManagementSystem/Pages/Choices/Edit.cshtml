@page "{id:guid}"
@model AAExamManagementSystem.Pages.Choices.EditModel
@{
    ViewData["Title"] = "Edit Choice";
}

<edit-card title="Edit Choice">
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Choice.ChoiceText" class="form-label"></label>
                    <textarea asp-for="Choice.ChoiceText" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Choice.ChoiceText" class="text-danger"></span>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="Choice.IsCorrect" class="form-check-input" role="switch" />
                    <label asp-for="Choice.IsCorrect" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="Choice.IsActive" class="form-check-input" role="switch" />
                    <label asp-for="Choice.IsActive" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</edit-card>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
