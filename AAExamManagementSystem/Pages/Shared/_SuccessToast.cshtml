@if (TempData["SuccessMessage"] is string successMessage)
{
    <script>
        showSuccessToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));
    </script>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <script>
        showErrorAlert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));
    </script>
}
