@model (bool isActive, string activeText, string inactiveText)

@if (Model.isActive)
{
    <span class="badge rounded-pill text-bg-success fs-6 fw-semibold px-3 py-2">@Model.activeText</span>
}
else
{
    <span class="badge rounded-pill text-bg-secondary fs-6 fw-semibold px-3 py-2">@Model.inactiveText</span>
}
