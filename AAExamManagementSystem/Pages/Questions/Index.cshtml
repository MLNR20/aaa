@page
@model AAExamManagementSystem.Pages.Questions.IndexModel
@using AAExamManagementSystem.Models.Entities
@{
    ViewData["Title"] = "Questions";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "questionsTable",
    basePath = "/Questions",
    emptyMessage = "No questions found.",
    items = Model.Questions.Select(q => new EntityTableRow(q.Id.ToString(), q.QuestionText.Length > 80 ? q.QuestionText.Substring(0, 80) + "…" : q.QuestionText, q.IsActive)),
    title = "Questions",
    addButtonText = "New Question",
    addButtonModalTarget = "#createQuestionModal",
    showStatusColumn = true,
    confirmDeleteWithSweetAlert = true
})

<div class="modal fade" id="createQuestionModal" tabindex="-1" aria-labelledby="createQuestionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="createQuestionModalLabel">New Question</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewQuestion.ExamId" class="form-label"></label>
                        <select asp-for="NewQuestion.ExamId" class="form-select" asp-items="Model.ExamOptions">
                            <option value="">-- Select Exam --</option>
                        </select>
                        <span asp-validation-for="NewQuestion.ExamId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewQuestion.QuestionText" class="form-label"></label>
                        <textarea asp-for="NewQuestion.QuestionText" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="NewQuestion.QuestionText" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewQuestion.QuestionType" class="form-label"></label>
                        <select asp-for="NewQuestion.QuestionType" class="form-select" asp-items="Html.GetEnumSelectList<QuestionType>()"></select>
                        <span asp-validation-for="NewQuestion.QuestionType" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewQuestion.OptionA" class="form-label"></label>
                            <input asp-for="NewQuestion.OptionA" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewQuestion.OptionB" class="form-label"></label>
                            <input asp-for="NewQuestion.OptionB" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewQuestion.OptionC" class="form-label"></label>
                            <input asp-for="NewQuestion.OptionC" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewQuestion.OptionD" class="form-label"></label>
                            <input asp-for="NewQuestion.OptionD" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewQuestion.CorrectAnswer" class="form-label"></label>
                        <input asp-for="NewQuestion.CorrectAnswer" class="form-control" />
                        <span asp-validation-for="NewQuestion.CorrectAnswer" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewQuestion.Points" class="form-label"></label>
                        <input asp-for="NewQuestion.Points" class="form-control" type="number" />
                        <span asp-validation-for="NewQuestion.Points" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="NewQuestion.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="NewQuestion.IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            if ($('#questionsTable').length) {
                $('#questionsTable').DataTable();
            }
            @if (Model.ShowCreateModal)
            {
                <text>new bootstrap.Modal(document.getElementById('createQuestionModal')).show();</text>
            }

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                </text>
            }

            document.querySelectorAll('.js-sweetalert-delete-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Delete question?',
                        text: 'Are you sure you want to delete this question? This action cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Delete',
                        confirmButtonColor: '#dc3545',
                        cancelButtonText: 'Cancel'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}
