@page
@model AAExamManagementSystem.Pages.Questions.IndexModel
@{
    ViewData["Title"] = "Questions";
}

@await Component.InvokeAsync("EntityTable", new
{
    tableId = "questionsTable",
    basePath = "/Questions",
    emptyMessage = "No questions found.",
    items = Model.Questions.Select(q => new EntityTableRow(q.Id.ToString(), q.QuestionTitle.Length > 80 ? q.QuestionTitle.Substring(0, 80) + "…" : q.QuestionTitle, q.IsActive)),
    title = "Questions",
    addButtonText = "New Question",
    addButtonHref = "/Questions/Create",
    showStatusColumn = true,
    confirmDeleteWithSweetAlert = true
})

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            if ($('#questionsTable').length) {
                $('#questionsTable').DataTable();
            }

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                </text>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Cannot delete question',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage))
                });
                </text>
            }

            document.querySelectorAll('.js-sweetalert-delete-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Delete question?',
                        text: 'Are you sure you want to delete this question and its choices? This action cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Delete',
                        confirmButtonColor: '#dc3545',
                        cancelButtonText: 'Cancel'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}
