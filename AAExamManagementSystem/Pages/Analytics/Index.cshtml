@page
@model AAExamManagementSystem.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics";
}

@functions {
    private static string Percent(int value, int max) =>
        max <= 0 ? "0" : Math.Round(value * 100.0 / max, 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
}

@{
    void RenderBars(string title, string icon, IList<AAExamManagementSystem.Pages.Analytics.BarItem> items, string emptyMessage)
    {
        var max = items.Count == 0 ? 0 : items.Max(i => i.Value);
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <h2 class="h6 fw-semibold mb-3"><i class="bi @icon me-2 text-primary" aria-hidden="true"></i>@title</h2>
                @if (items.Count == 0)
                {
                    <p class="text-muted small mb-0">@emptyMessage</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 analytics-bars">
                        @foreach (var item in items)
                        {
                            <li class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-truncate me-2" title="@item.Label">@item.Label</span>
                                    <span class="fw-semibold">@item.Value</span>
                                </div>
                                <div class="progress" role="progressbar" aria-label="@item.Label" aria-valuenow="@item.Value" aria-valuemin="0" aria-valuemax="@max" style="height: .5rem;">
                                    <div class="progress-bar" style="width: @Percent(item.Value, max)%"></div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">Analytics</h1>
        <p class="text-muted mb-0">Snapshot of departments, sections, questions and exam activity.</p>
    </div>
    @if (Model.AverageScore is double avg)
    {
        <div class="text-end">
            <div class="small text-muted">Average attempt score</div>
            <div class="fs-4 fw-bold">@avg.ToString("0.0")</div>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    @foreach (var tile in Model.Tiles)
    {
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-start justify-content-between">
                    <div>
                        <div class="small text-muted">@tile.Label</div>
                        <div class="fs-3 fw-bold lh-sm">@tile.Total</div>
                        <div class="small text-muted">
                            <span class="text-success fw-semibold">@tile.Active</span> active
                            @if (tile.Total - tile.Active > 0)
                            {
                                <span>· @(tile.Total - tile.Active) inactive</span>
                            }
                        </div>
                    </div>
                    <i class="bi @tile.Icon fs-4 text-primary" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        @{ RenderBars("Users by department", "bi-building", Model.UsersByDepartment, "No departments yet."); }
    </div>
    <div class="col-12 col-lg-6">
        @{ RenderBars("Questions by section", "bi-diagram-3", Model.QuestionsBySection, "No sections yet."); }
    </div>
    <div class="col-12 col-lg-6">
        @{ RenderBars("Questions by type", "bi-list-check", Model.QuestionsByType, "No question types yet."); }
    </div>
    <div class="col-12 col-lg-6">
        @{ RenderBars("Exam attempts (last 6 months)", "bi-graph-up", Model.AttemptsByMonth, "No attempts yet."); }
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3"><i class="bi bi-calendar-event me-2 text-primary" aria-hidden="true"></i>Upcoming exams</h2>
        @if (Model.UpcomingExams.Count == 0)
        {
            <p class="text-muted small mb-0">No upcoming exams scheduled.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Title</th><th>Course</th><th>Date</th><th class="text-end">Duration</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.UpcomingExams)
                        {
                            <tr>
                                <td>@exam.Title</td>
                                <td>@exam.Course</td>
                                <td>@exam.ExamDate.ToString("MMM d, yyyy h:mm tt")</td>
                                <td class="text-end">@exam.DurationMinutes min</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
